{
  // Type-checking config for the app. Vite/esbuild only strips types at build
  // time and never checks them, so `npm run typecheck` (tsc --noEmit) is what
  // actually enforces them — it runs in CI on every push. No emit happens
  // here; Vite still owns the build.
  //
  // MIGRATION BRIDGE (remove once src/ has no .js/.jsx left):
  //   allowJs + checkJs:false let an already-converted .tsx import a module
  //   that is still .jsx. Without it the first converted component fails to
  //   resolve its not-yet-converted imports and CI goes red, which would force
  //   the whole migration into one unreviewable commit. The .jsx files are
  //   resolved and inferred, never type-checked, so they cost nothing until
  //   they're converted.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "allowJs": true,
    "checkJs": false,

    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"]
}
